# WILL environment template.
#
# The Python backend reads process environment variables. It does not load this
# file automatically; export the values in your shell or set them in your
# process manager. On PowerShell:
#   $env:WILL_DEVICE = "cpu"
#
# Leave WILL_API_KEY empty for local development. If set, every API request
# must send the matching X-API-Key header. The Next.js console uses
# NEXT_PUBLIC_API_KEY for that header.

# auto | cpu | cuda
WILL_DEVICE=auto

# Optional storage overrides. Defaults are relative to the repository root.
# WILL_DATA_DIR=C:\Users\you\Documents\WILL\data
# WILL_CHECKPOINT_DIR=C:\Users\you\Documents\WILL\checkpoints
# WILL_EXPERIMENT_DIR=C:\Users\you\Documents\WILL\experiments

# Optional shared-secret auth for the API.
WILL_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (copy to frontend/.env.local; Next.js loads that file automatically)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_KEY=
